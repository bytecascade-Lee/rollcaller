{
    $schema: "../docs/schema/tauri-config.schema.json",
    bundle: {
        active: true,
        targets: [
            "nsis"
        ],
        windows: {
            nsis: {
                installMode: "both",
                languages: [
                    "SimpChinese",
                    "TradChinese",
                    "English"
                ],
                installerIcon: "icons/icon.ico",
                uninstallerIcon: "icons/uninstall.ico",
                startMenuFolder: "Rollcaller",
                displayLanguageSelector: true
            }
        }
    }
}
