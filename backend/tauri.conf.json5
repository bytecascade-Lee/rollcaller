{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rollcaller",
  "version": "0.0.0",
  "identifier": "com.serene.desktop.rollcaller",
  "build": {
    "beforeDevCommand": "cd ./frontend && pnpm dev",
    "devUrl": "http://localhost:14650",
    "beforeBuildCommand": "cd ./frontend && pnpm build",
    "frontendDist": "../frontend/build"
  },
  "app": {
    "windows": [
      {
        "title": "rollcaller",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
