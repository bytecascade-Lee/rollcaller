{
    $schema: "../docs/schema/tauri-config-schema.json",
    productName: "rollcaller",
    version: "0.1.0-alpha.1",
    identifier: "com.serene.client.rollcaller",
    build: {
        beforeDevCommand: "cd ./frontend && pnpm dev",
        devUrl: "http://localhost:14650",
        beforeBuildCommand: "cd ./frontend && pnpm build",
        frontendDist: "../frontend/dist"
    },
    app: {
        security: {
            csp: null
        }
    },
    bundle: {
        active: true,
        targets: "all",
        icon: [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        resources: {
            "../resources/config/": "config/",
            "../resources/database/": "database/"
        }
    }
}
