{
    $schema: "../docs/schema/tauri-config-schema.json",
    productName: "rollcaller",
    version: "0.1.0-dev",
    identifier: "com.serene.client.rollcaller",
    build: {
        beforeDevCommand: "cd ./frontend && pnpm dev",
        devUrl: "http://localhost:14650",
        beforeBuildCommand: "cd ./frontend && pnpm build",
        frontendDist: "../frontend/dist"
    },
    app: {
        security: {
            csp: null
        }
    },
    bundle: {
        active: true,
        createUpdaterArtifacts: true,
        targets: "all",
        icon: [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        resources: {
            "../resources/config/": "config/",
            "../resources/database/": "database/",
            "../resources/help/": "help/",
            "../README.md": "README.md",
            "../LICENSE": "LICENSE",
            "../CHANGELOG.md": "CHANGELOG.md",
            "../RELEASE_NOTES.md": "RELEASE_NOTES.md"
        }
    },
    plugins: {
        "updater": {
            "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA0RTkzMTA5QTZGREZDNzkKUldSNS9QMm1DVEhwQkRCdjlXV2JVb1FLWFZ2cEMrMWcralhVWTViRkFQcGdGTUxPL2gwZ1V0WEQK",
            "endpoints": [
                "https://github.com/bytecascade-Lee/rollcaller/releases/latest/download/latest-github.json",
                "https://cnb.cool/ordinary-glory/rollcaller/-/releases/latest/download/latest-cnb.json"
            ]
        }
    }
}
