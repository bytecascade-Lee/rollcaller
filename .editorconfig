root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

### Frontend files' indentation is 2 spaces ###
[*.{html,svelte,vue,js,ts,jsx,tsx,cjs,mjs}]
indent_size = 2

### The line break character for Windows platform files is 'CRLF' ###
[*.{bat,cmd,ps1}]
end_of_line = crlf

### Markdown files remain unchanged ###
[*.md]
trim_trailing_whitespace = false

### 数据库迁移脚本：checksum 按工作区字节计算，行尾/尾部空白都会改变哈希 ###
### 与 .gitattributes 的 `resources/database/migrations/*.sql text eol=crlf` 必须同步 ###
[resources/database/migrations/*.sql]
end_of_line = crlf
trim_trailing_whitespace = false
